# Shared
PROJECT_NAME=The Playground (Lab)
APP_ENV=production

# Backend
API_PORT=8000
MONGO_URI=mongodb://mongo:27017/lab
MONGO_DB_NAME=lab

# Comma-separated or JSON array string, e.g. ["https://lab.example.com","https://app.example.com"]
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_PROBE_URL=http://frontend:3000
FRONTEND_PROBE_TIMEOUT_SECONDS=1.5
INTERNAL_AUTH_SECRET=replace-with-long-random-internal-secret

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://backend:8000
AUTH_SECRET=replace-with-long-random-secret
# Optional OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=