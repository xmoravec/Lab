# Shared
PROJECT_NAME=The Playground (Lab)
APP_ENV=production

# Backend
API_PORT=8000
MONGO_URI=mongodb://mongo:27017/lab
MONGO_DB_NAME=lab
MONGO_MAX_POOL_SIZE=10

# Comma-separated or JSON array string, e.g. ["https://lab.example.com","https://app.example.com"]
CORS_ORIGINS=https://lab.xmoravec.com,https://www.lab.xmoravec.com,http://localhost:3000,http://127.0.0.1:3000
ENABLE_GZIP=true
GZIP_MINIMUM_SIZE_BYTES=500
GZIP_COMPRESS_LEVEL=5
FRONTEND_PROBE_URL=http://frontend:3000
FRONTEND_PROBE_TIMEOUT_SECONDS=1.5
INTERNAL_AUTH_SECRET=replace-with-long-random-internal-secret

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional compatibility alias (used if NEXT_PUBLIC_API_BASE_URL is unset)
NEXT_PUBLIC_API_URL=
API_INTERNAL_BASE_URL=http://backend:8000
AUTH_SECRET=replace-with-long-random-secret
# Optional OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=