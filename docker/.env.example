# Local Docker Compose environment (copy to docker/.env)
# Required secrets (generate long random values):
INTERNAL_AUTH_SECRET=replace-with-long-random-secret
AUTH_SECRET=replace-with-long-random-secret

# Auth.js canonical host for local frontend container:
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false

# Optional local ports:
API_PORT=8000
WEB_PORT=3000

# Optional frontend/backend URL wiring:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_INTERNAL_BASE_URL=http://backend:8000

# Optional backend runtime tuning:
APP_ENV=production
PORT=8000
MONGO_URI=mongodb://mongo:27017/lab
MONGO_DB_NAME=lab
MONGO_MAX_POOL_SIZE=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_GZIP=true
GZIP_MINIMUM_SIZE_BYTES=500
GZIP_COMPRESS_LEVEL=5
FRONTEND_PROBE_URL=http://frontend:3000
FRONTEND_PROBE_TIMEOUT_SECONDS=1.5

# Optional OAuth (leave blank if not used locally):
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
